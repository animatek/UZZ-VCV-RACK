# VCV Rack plugin
/build/
/dist/
# dep/ es del SDK: ahí instala las dependencias que compila el plugin, y
# `make cleandep` lo borra entero. No poner código fuente aquí; el Open303
# vendorizado vive en thirdparty/open303/ y sí va al repo.
/dep/
/.cache/
/bin/
/obj/

